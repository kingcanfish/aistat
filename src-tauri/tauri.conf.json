{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIStat",
  "version": "0.1.0",
  "identifier": "com.aistat.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AIStat",
        "width": 348,
        "height": 200,
        "minWidth": 348,
        "minHeight": 120,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "windowEffects": {
          "effects": ["popover", "mica", "acrylic"],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
